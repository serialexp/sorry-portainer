[Unit]
Description=Sorry Portainer development Podman agent __HOST_ID__
After=sorry-portainer-server.service

[Service]
Type=simple
WorkingDirectory=__ROOT__
# Adds the agent's OCI hook directory (stack secrets) for this agent's Podman
# calls only. Production agents get it from setup's containers.conf drop-in.
Environment=CONTAINERS_CONF_OVERRIDE=__STATE__/containers-hooks.conf
ExecStart=__BIN__/sorry-portainer-agent --config __STATE__/agents/__HOST_ID__/agent.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
